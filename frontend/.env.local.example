# Copy to .env.local for local dev. Vercel holds the production values as project
# environment variables — see CLAUDE.md -> Conventions for why the frontend normally
# needs only BACKEND_URL (browser never calls the backend directly, Route Handlers do it
# server-side).
BACKEND_URL=http://localhost:8001

# The one deliberate exception: frontend/src/app/reset-password/page.tsx talks to
# Supabase directly from the browser (Supabase's password-recovery flow requires it — see
# that page's comment). The anon key is meant to be public (RLS-protected), unlike every
# other secret in this project — Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
