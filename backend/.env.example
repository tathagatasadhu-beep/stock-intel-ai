# Copy to backend/.env for local dev. Real values also go into Render's environment
# variables for production — never commit real values here.

# Supabase Postgres — use the CONNECTION POOLER string (transaction mode, port 6543),
# not the direct-connection host (IPv6-only, unreachable from Render). Get it from
# Supabase dashboard -> Project Settings -> Database -> Connect -> pooler.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Supabase Auth (investor login) — Project Settings -> API -> Project URL / anon public key
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# Only needed if you add a first-party JWT flow later (not used by the MVP's
# Supabase-only auth, kept for parity with EduQuestAI's pattern)
APP_JWT_SECRET=

# Where Supabase sends a user after clicking a "reset password" email link — must also be
# added to Supabase -> Authentication -> URL Configuration -> Redirect URLs, or Supabase
# silently ignores it and falls back to whatever Site URL is set there (often still
# localhost, which is why this needs to be set explicitly in both places).
FRONTEND_URL=https://stock-intel-ai-alpha.vercel.app

# AI plain-English analysis (services/ai_engine.py)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Market data: fundamentals, ratios, price candles (services/market_data.py)
FMP_API_KEY=

# News feed (services/news.py) — Finnhub's company-news endpoint
FINNHUB_API_KEY=

# Outbound email for alerts (services/email_alerts.py)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Optional — screener result caching / provider rate-limit buffering
REDIS_URL=
